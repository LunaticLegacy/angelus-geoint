# Python virtual environments
.lvenv/
.venv/
venv/
env/

# Build artifacts from `python -m build`
dist/
build/
*.egg-info/
*.egg

# Python cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# IDE and editor files
.vscode/
.idea/
node_modules/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Environment variables
.env
.env.local

# Documentation build
docs/_build/

# Temporary files
*.tmp
*.temp

# LLM
.qwen
.codex
.codetalk/

# Local browser sessions, connectors, and migration backups.
workspace/
.angelus-state/
.llmfetcher/
.dsh-ref/

# Local RAG datasets and generated indexes are not part of the superproject.
benchmark/
workspace/

# Tauri and PyInstaller build outputs.
src-tauri/target/
src-tauri/gen/
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep
/*-backend.spec

# Angelus-based plugin packages are normally local, except the bundled source
# examples kept under version control for development discovery and regression
# coverage.
/plugins/*
!/plugins/INDEX.md
!/plugins/angelus/
!/plugins/angelus/**
!/plugins/angelus-control-plane-ui-v0.2.2/
!/plugins/angelus-control-plane-ui-v0.2.2/**
!/plugins/demo-hello/
!/plugins/demo-hello/**
!/plugins/example-tool/
!/plugins/example-tool/**
!/plugins/pofp-ctf/
!/plugins/pofp-ctf/**
!/plugins/gzctf/
!/plugins/gzctf/**
/plugins/gzctf/cookies.txt
/plugins/gzctf/__pycache__/
/plugins/gzctf/data/
!/plugins/token-burner/
!/plugins/token-burner/**
plugins/**/__pycache__/


# Spike generated ledger (real transcript data, not part of the repo).
scripts/spike_product_adapters/out/

# Large generated exports and presentation artifacts kept out of the repo
# (exports/ ~304 files / 546MB, docs/final-ppt/ ~22 files / 3.6MB, one-off renderer).
exports/
docs/final-ppt/
/render-intro.mjs

# Root-level working reports. NOTE: rss-monitor-report.md, test-baseline-report.md and
# verify-compactor-report.md are still tracked; .gitignore does not untrack anything.
# Untracking them is deliberately left to the maintainer.
/*-report.md

# Local pytest scratch roots and archived working copies.
.pytest-tmp*/
.archive/

# Tauri bundler output (defence in depth: src-tauri/target/ above already covers the
# default path; these catch copied-in bundles and the other bundler formats).
src-tauri/bundle/
src-tauri/**/*.msi
src-tauri/**/*.nsis.zip
src-tauri/**/*.deb
src-tauri/**/*.rpm
src-tauri/**/*.AppImage
src-tauri/**/*.exe

# Local canary/secret material: kept on disk for local checks only, never tracked.
# Root-anchored on purpose, so a fixture named flag.txt elsewhere is unaffected.
/flag.txt
